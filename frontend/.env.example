# Liste de référence du déploiement (voir 00readme/PLAN_CD.md) : ligne active = obligatoire, « # NOM= » = facultative.
# Toutes ces valeurs sont publiques (intégrées au JavaScript) : jamais de secret ici.
# VITE_API_URL et VITE_API_V1_URL sont OBLIGATOIRES (l'application refuse de démarrer sans elles).
# Chemins relatifs : le serveur Vite relaie /api vers Django (même origine, cookies HttpOnly).
VITE_API_URL=/api
VITE_API_V1_URL=/api/v1
# Facultative : vide ou absente = fichiers servis depuis /media/ (disque local).
# true = le backend a USE_S3=True : les fichiers sont lus via /api/v1/files/ (utilisateur connecté uniquement).
# VITE_USE_S3=

# Facultatives — préremplissage du formulaire login UNIQUEMENT en mode Vite DEV
# (import.meta.env.DEV). Aligner sur backend ADMIN_EMAIL / ADMIN_PASSWORD. Jamais en prod.
# VITE_DEV_LOGIN_EMAIL=admin@devstreet.local
# VITE_DEV_LOGIN_PWD=
