{
  "model": "User",
  "attributes": [
    { "name": "username", "type": "string", "required": true, "unique": true },
    { "name": "email", "type": "string", "required": true, "unique": true },
    { "name": "first_name", "type": "string", "required": true },
    { "name": "last_name", "type": "string", "required": true },
    {
      "name": "password",
      "type": "string",
      "required": true,
      "minLength": 8,
      "writeOnly": true
    },
    {
      "name": "password_confirm",
      "type": "string",
      "required": true,
      "writeOnly": true
    },
    {
      "name": "role_names",
      "type": "array",
      "required": false,
      "items": { "type": "string" }
    },
    {
      "name": "is_active",
      "type": "boolean",
      "required": false,
      "default": true
    }
  ]
}
