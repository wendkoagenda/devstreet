{
  "model_name": "Project",
  "app_name": "projects",
  "fields": [
    {"name": "title", "type": "CharField", "max_length": 180},
    {"name": "slug", "type": "SlugField", "max_length": 100, "unique": true},
    {"name": "problem", "type": "TextField", "blank": true, "default": ""},
    {"name": "description", "type": "TextField", "blank": true, "default": ""},
    {"name": "demo_url", "type": "URLField", "blank": true, "default": ""},
    {"name": "declared_license", "type": "CharField", "max_length": 50, "default": "MIT"},
    {"name": "status", "type": "CharField", "max_length": 20, "default": "draft", "choices": [["draft", "Brouillon"], ["published", "Publié"], ["archived", "Archivé"]]}
  ],
  "meta": {"db_table": "projects_project", "resource_plural": "projects", "verbose_name": "Projet", "verbose_name_plural": "Projets"}
}
