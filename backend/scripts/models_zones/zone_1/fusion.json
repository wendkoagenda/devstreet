{
  "model_name": "Fusion",
  "app_name": "metier",
  "fields": [
    {
      "name": "id",
      "type": "AutoField",
      "primary_key": true
    },
    {
      "name": "uuid",
      "type": "UUIDField",
      "default": "uuid.uuid4",
      "editable": false,
      "unique": true,
      "visible_in_table": false,
      "visible_in_dialog": false
    },
    {
      "name": "titre",
      "type": "CharField",
      "max_length": 200,
      "blank": false,
      "null": false
    },
    {
      "name": "statut",
      "type": "CharField",
      "max_length": 20,
      "choices": [
        ["draft", "Brouillon"],
        ["published", "Publie"],
        ["archived", "Archive"]
      ],
      "blank": false,
      "null": false,
      "visible_in_table": true,
      "visible_in_dialog": true
    },
    {
      "name": "description",
      "type": "TextField",
      "blank": true,
      "null": true
    },
    {
      "name": "prix",
      "type": "DecimalField",
      "max_digits": 10,
      "decimal_places": 2,
      "blank": false,
      "null": false
    },
    {
      "name": "document",
      "type": "FileField",
      "upload_folder": "fusion_documents",
      "allowed_extensions": [".pdf", ".png"],
      "max_size_mb": 5,
      "blank": true,
      "null": true,
      "visible_in_table": true,
      "visible_in_dialog": true
    }
  ],
  "meta": {
    "db_table": "metier_fusion",
    "verbose_name": "Fusion",
    "verbose_name_plural": "Fusions",
    "resource_plural": "fusions",
    "ordering": ["-created_at"]
  }
}
