{
  "model": "Prestation",
  "app": "marketplace",
  "description": "Service packagé vendu par un dev (ex. « Landing page en 5 jours »).",
  "fields": {
    "title": { "type": "CharField", "max_length": 150, "required": true, "description": "Titre de la prestation" },
    "slug": { "type": "SlugField", "max_length": 160, "unique": true, "required": true, "description": "URL publique" },
    "description": { "type": "TextField", "required": true, "description": "Contenu de la prestation" },
    "category": { "type": "CharField", "max_length": 20, "choices": ["web", "mobile", "design", "devops", "data", "other"], "required": true, "description": "Catégorie" },
    "price": { "type": "DecimalField", "max_digits": 12, "decimal_places": 2, "required": true, "description": "Prix fixe" },
    "currency": { "type": "CharField", "max_length": 3, "default": "XOF", "description": "Devise ISO 4217" },
    "delivery_days": { "type": "PositiveSmallIntegerField", "required": true, "description": "Délai de livraison en jours" },
    "revisions": { "type": "PositiveSmallIntegerField", "default": 1, "description": "Nombre de retouches incluses" },
    "cover_image": { "type": "ImageField", "required": false, "description": "Visuel de présentation" },
    "is_active": { "type": "BooleanField", "default": true, "description": "Visible sur la marketplace" }
  }
}
