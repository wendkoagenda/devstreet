            {{ model.model_name }}: Le {{ model.snake_name }} créé
        """
        return {{ model.model_name }}.objects.create(**kwargs)

    def update(self, {{ model.snake_name }}: {{ model.model_name }}, **kwargs) -> {{ model.model_name }}:
        """
        Mettre à jour un {{ model.snake_name }} existant.

        Args:
            {{ model.snake_name }} ({{ model.model_name }}): Le {{ model.snake_name }} à mettre à jour
            **kwargs: Données mises à jour

        Returns:
            {{ model.model_name }}: Le {{ model.snake_name }} mis à jour
        """
        for field, value in kwargs.items():
            if hasattr({{ model.snake_name }}, field):
                setattr({{ model.snake_name }}, field, value)

        {{ model.snake_name }}.save()
        return {{ model.snake_name }}

    def delete(self, {{ model.snake_name }}: {{ model.model_name }}) -> bool:
        """
        Supprimer un {{ model.snake_name }}.

        Args:
            {{ model.snake_name }} ({{ model.model_name }}): Le {{ model.snake_name }} à supprimer

        Returns:
            bool: True si supprimé avec succès
        """
        {{ model.snake_name }}.delete()
        return True

    def exists_by_id(self, {{ model.snake_name }}_id: int) -> bool:
        """
        Vérifier si un {{ model.snake_name }} existe par ID.

        Args:
            {{ model.snake_name }}_id (int): L'ID du {{ model.snake_name }}

        Returns:
            bool: True si le {{ model.snake_name }} existe, False sinon
        """
        return {{ model.model_name }}.objects.filter(id={{ model.snake_name }}_id).exists()
