from typing import List, Optional
from django.db.models import QuerySet, Q
from app.{{ model.app_name }}.models import {{ model.model_name }}
from app.{{ model.app_name }}.interfaces.{{ model.model_name|lower }}_repository_interface import {{ model.model_name }}RepositoryInterface


class {{ model.model_name }}Repository({{ model.model_name }}RepositoryInterface):
    """
    Implémentation concrète des opérations du repository {{ model.model_name|lower }}s.
    """

    # Champs sur lesquels porte la recherche textuelle (?search=) et champs autorisés pour le tri (?ordering=)
    SEARCH_FIELDS = ({% for f in search_fields %}'{{ f }}'{% if not loop.last %}, {% else %},{% endif %}{% endfor %})
    ORDERING_FIELDS = ({% for f in ordering_fields %}'{{ f }}'{% if not loop.last %}, {% else %},{% endif %}{% endfor %})

    def get_all(self, search: Optional[str] = None, ordering: Optional[str] = None) -> QuerySet:
        """
        Obtenir les {{ model.snake_name }}, avec recherche textuelle et tri facultatifs.

        Args:
            search (Optional[str]): Texte recherché (insensible à la casse) dans les champs texte
            ordering (Optional[str]): Champ de tri, préfixé par « - » pour l'ordre décroissant

        Returns:
            QuerySet: Les {{ model.snake_name }} filtrés et triés (tri stable : l'ID départage les égalités)

        Raises:
            ValueError: Si le champ de tri n'est pas autorisé
        """
        queryset = {{ model.model_name }}.objects.all()
        if search:
            condition = Q()
            for field_name in self.SEARCH_FIELDS:
                condition |= Q(**{f'{field_name}__icontains': search})
            queryset = queryset.filter(condition)
        if ordering:
            if ordering.lstrip('-') not in self.ORDERING_FIELDS:
                raise ValueError(f'Tri non autorisé : {ordering}')
            return queryset.order_by(ordering, 'id')
        return queryset.order_by('id')

    def get_by_id(self, {{ model.snake_name }}_id: int) -> Optional[{{ model.model_name }}]:
        """
        Obtenir un {{ model.snake_name }} par ID.

        Args:
            {{ model.snake_name }}_id (int): L'ID du {{ model.snake_name }}

        Returns:
            Optional[{{ model.model_name }}]: Le {{ model.snake_name }} si trouvé, None sinon
        """
        return {{ model.model_name }}.objects.filter(id={{ model.snake_name }}_id).first()

{% if has_uuid_field %}
