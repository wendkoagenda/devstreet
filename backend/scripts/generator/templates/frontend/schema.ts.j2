import { z } from "zod";
import type { TFunction } from "i18next";

export const {{ model_name_camel }}Schema = z.object({
{% for field in fields %}
  {{ field.name }}: {{ field.zod_type }},
{% endfor %}
{% for field in file_fields %}
  {{ field.name }}_url: z.string().optional(),
{% endfor %}
});

export type {{ model_name_pascal }}Schema = z.infer<typeof {{ model_name_camel }}Schema>;

export const create{{ model_name_pascal }}Schema = (t: TFunction) =>
  z.object({
{% for field in scalar_form_fields %}
    {{ field.name }}: {{ field.zod_form_expr }},
{% endfor %}
  });

export type Create{{ model_name_pascal }}FormValues = {
{% for field in scalar_form_fields %}
