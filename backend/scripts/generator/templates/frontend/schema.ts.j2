{% endfor %}
};

export type Create{{ model_name_pascal }}Schema = {
{% for field in scalar_form_fields %}
  {{ field.name }}{% if field.is_optional %}?{% endif %}: {{ field.output_ts_type }};
{% endfor %}
};

export type Get{{ model_name_pascal }}Schema = {
  id: number;
{% for field in fields if field.name != 'id' %}
  {{ field.name }}{% if field.is_optional %}?{% endif %}: {{ field.ts_type | replace(' | undefined', '') }};
{% endfor %}
{% for field in file_fields %}
  {{ field.name }}_url?: string;
{% endfor %}
};

