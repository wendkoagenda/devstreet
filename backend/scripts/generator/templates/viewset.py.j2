class {{ model.model_name }}ViewSet(viewsets.ModelViewSet):
    """
    ViewSet pour les opérations CRUD sur les {{ model.snake_name }}s.
    """
    swagger_tags = ['V1 - {{ model.model_name }}']
    queryset = {{ model.model_name }}.objects.all()
    serializer_class = {{ model.model_name }}Serializer
    permission_classes = [IsAuthenticated]
{% if model.has_file_fields() %}
    parser_classes = [MultiPartParser, FormParser, JSONParser]
    FILE_FIELD_CONFIG = {
{% for field in file_fields %}
        "{{ field.name }}": {
            "upload_folder": "{{ field.upload_folder }}",
            "allowed_extensions": {{ field.allowed_extensions }},
            "max_size_mb": {{ field.max_size_mb }},
        },
{% endfor %}
    }
    FILE_FIELD_NAMES = [{% for name in file_field_names %}"{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.{{ model.model_name|lower }}_service = {{ model.model_name }}Service()

{% if model.has_file_fields() %}
    def _prepare_write_data(self, request):
        data = flatten_request_data(request.data)
        for field_name in self.FILE_FIELD_NAMES:
            data.pop(f"{field_name}_path", None)
        uploaded_paths = process_uploaded_files(request, self.FILE_FIELD_CONFIG)
        data.update(uploaded_paths)
        return data
{% endif %}

    def get_permissions(self):
        """
        Retourne les permissions requises selon l'action.
        """
        if self.action == 'list' or self.action == 'retrieve':
            permission_classes = [CanView{{ model.model_name }}]
        elif self.action == 'create':
            permission_classes = [CanCreate{{ model.model_name }}]
        elif self.action in ['update', 'partial_update']:
            permission_classes = [CanUpdate{{ model.model_name }}]
        elif self.action == 'destroy':
            permission_classes = [CanDelete{{ model.model_name }}]
        else:
            permission_classes = [IsAuthenticated]

        return [permission() for permission in permission_classes]

    @swagger_auto_schema(
        operation_description="Lister les {{ model.snake_name }}s (paginé : 20 par page, 100 au maximum)",
        manual_parameters=[
            openapi.Parameter('page', openapi.IN_QUERY, description="Numéro de page", type=openapi.TYPE_INTEGER),
            openapi.Parameter('page_size', openapi.IN_QUERY, description="Taille de page (100 au maximum)", type=openapi.TYPE_INTEGER),
            openapi.Parameter('search', openapi.IN_QUERY, description="Recherche textuelle", type=openapi.TYPE_STRING),
            openapi.Parameter('ordering', openapi.IN_QUERY, description="Champ de tri, préfixé par - pour décroissant", type=openapi.TYPE_STRING),
        ],
        responses={200: {{ model.model_name }}Serializer(many=True), 400: "Tri invalide"},
        security=[{'Bearer': []}],
        tags=['V1 - {{ model.model_name }}']
    )
    def list(self, request):
        """
        Retourne une page de {{ model.snake_name }}s (format : count, next, previous, results).
        """
        try:
            {{ model.snake_name }}s = self.{{ model.model_name|lower }}_service.get_all(
                search=request.query_params.get('search'),
                ordering=request.query_params.get('ordering'),
            )
        except ValueError:
            return Response({'error': 'Tri invalide'}, status=status.HTTP_400_BAD_REQUEST)
        page = self.paginate_queryset({{ model.snake_name }}s)
        serializer = self.get_serializer(page, many=True)
        return self.get_paginated_response(serializer.data)

    @swagger_auto_schema(
        operation_description="Récupérer un {{ model.snake_name }} par son ID",
        responses={
            200: {{ model.model_name }}Serializer,
            404: "{{ model.model_name }} non trouvé"
        },
        security=[{'Bearer': []}],
        tags=['V1 - {{ model.model_name }}']
    )
    def retrieve(self, request, pk=None):
        """
        Retourne les détails d'un {{ model.snake_name }} spécifique.
        """
        {{ model.snake_name }} = self.{{ model.model_name|lower }}_service.get_by_id(pk)
        if not {{ model.snake_name }}:
            return Response(
                {'error': '{{ model.model_name }} non trouvé'},
                status=status.HTTP_404_NOT_FOUND
            )
        serializer = self.get_serializer({{ model.snake_name }})
        return Response(serializer.data)

    @swagger_auto_schema(
