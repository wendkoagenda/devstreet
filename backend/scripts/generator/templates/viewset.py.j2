            400: "Données invalides"
        },
        security=[{'Bearer': []}],
        tags=['V1 - {{ model.model_name }}']
    )
    def create(self, request):
        """
        Crée un nouveau {{ model.snake_name }}.
        """
        try:
            data = request.data.copy()
{% if model.has_file_fields() %}
            data = self._prepare_write_data(request)
{% endif %}
            data.pop('created_by', None)
            data.pop('updated_by', None)
            data.pop('created_at', None)
            data.pop('updated_at', None)
            if hasattr(request, 'user') and request.user and getattr(request.user, 'id', None) is not None:
                data['created_by'] = request.user.id
                data['updated_by'] = request.user.id
            {{ model.snake_name }} = self.{{ model.model_name|lower }}_service.create(data)
            serializer = self.get_serializer({{ model.snake_name }})
            return Response(serializer.data, status=status.HTTP_201_CREATED)
        except ValidationError as e:
            return Response(
                {'error': str(e)},
                status=status.HTTP_400_BAD_REQUEST
            )

