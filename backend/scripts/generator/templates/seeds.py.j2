"""Fichier de seeds pour {{ model.model_name }}."""
{% set has_uuid_field = model.fields.values() | selectattr('type', 'equalto', 'UUIDField') | list | length > 0 %}
from django.core.management.base import BaseCommand
from app.core.models import Permission
from app.{{ model.app_name }}.models import {{ model.model_name }}
from app.core.models import User, Role
from django.conf import settings
{% if has_uuid_field %}
import uuid
{% endif %}
from datetime import datetime, timedelta
import random
import string
from decimal import Decimal


class Command(BaseCommand):
    help = 'Créer des données de test pour {{ model.model_name }}'

    def handle(self, *args, **options):
        """Créer des données de test pour {{ model.model_name }}."""
        self.stdout.write(self.style.SUCCESS('Création des seeds pour {{ model.model_name }}...'))
        
        # Créer les permissions pour le modèle {{ model.model_name }}
        self.create_permissions()
        
        # Récupérer ou créer l'administrateur (identifiants : variables ADMIN_EMAIL / ADMIN_PASSWORD)
        try:
            user = User.objects.get(email=settings.ADMIN_EMAIL)
        except User.DoesNotExist:
            user = User.objects.create_user(
                username='admin',
                email=settings.ADMIN_EMAIL,
                password=settings.ADMIN_PASSWORD,
                is_staff=True,
                is_superuser=True
            )
            self.stdout.write(self.style.WARNING('Utilisateur admin créé'))
            
        # Assigner les permissions à l'utilisateur admin
        self.assign_permissions_to_admin_role()
        
        existing_count = {{ model.model_name }}.objects.count()
        if existing_count > 0:
            self.stdout.write(
                self.style.WARNING(
                    'La table {{ model.snake_name }} contient deja '
                    + str(existing_count)
                    + ' enregistrement(s). Seeds de donnees ignores.'
                )
            )
            return
        
        # Fonction pour générer des valeurs uniques
        def generate_unique_string(base_name, index, length=10):
            """Génère une chaîne unique basée sur un nom de base et un index."""
            timestamp = str(int(datetime.now().timestamp()))
            random_suffix = ''.join(random.choices(string.ascii_lowercase + string.digits, k=length))
            return f"{base_name}_{index}_{timestamp}_{random_suffix}"
        
        def generate_unique_email(index):
            """Génère un email unique."""
            timestamp = str(int(datetime.now().timestamp()))
            return f"test_{index}_{timestamp}@example.com"
        
        def generate_unique_url(index):
            """Génère une URL unique."""
            timestamp = str(int(datetime.now().timestamp()))
            return f"https://example{index}-{timestamp}.com"
        
        def generate_unique_decimal(base_value, index):
            """Génère une valeur décimale unique."""
            return Decimal(str(base_value + (index * 10) + random.uniform(0.01, 9.99)))
        
        # Créer des données de test avec des valeurs uniques
        {{ model.snake_name }}_data = []
        
        for i in range(1, 4):  # Créer 3 enregistrements de test
            data = {
{%- if has_uuid_field %}
                'uuid': str(uuid.uuid4()),
{%- endif %}
{%- for field_name, field in model.fields.items() %}
{%- if field_name not in ['id', 'created_by', 'updated_by', 'created_at', 'updated_at', 'uuid'] %}
{%- if field.is_file_field %}
                '{{ field_name }}': None,
{%- elif field.choices %}
                '{{ field_name }}': [{% for choice in field.choices %}{% if choice[0] is string %}'{{ choice[0] }}'{% else %}{{ choice[0] }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}][(i - 1) % {{ field.choices|length }}],
{%- elif field.type == 'CharField' %}
                '{{ field_name }}': generate_unique_string('{{ field_name }}', i, 8),
{%- elif field.type == 'TextField' %}
                '{{ field_name }}': f'Contenu de test unique pour {{ field_name }} #{i} - {generate_unique_string("content", i, 12)}',
{%- elif field.type == 'DecimalField' %}
                '{{ field_name }}': generate_unique_decimal(99.99, i),
{%- elif field.type == 'IntegerField' or field.type == 'PositiveIntegerField' %}
                '{{ field_name }}': i * 100 + random.randint(1, 99),
{%- elif field.type == 'BooleanField' %}
                '{{ field_name }}': bool(i % 2),
{%- elif field.type == 'DateTimeField' %}
                '{{ field_name }}': datetime.now() - timedelta(days=i, hours=random.randint(0, 23)),
{%- elif field.type == 'DateField' %}
                '{{ field_name }}': (datetime.now() - timedelta(days=i)).date(),
{%- elif field.type == 'EmailField' %}
                '{{ field_name }}': generate_unique_email(i),
{%- elif field.type == 'URLField' %}
                '{{ field_name }}': generate_unique_url(i),
{%- else %}
                '{{ field_name }}': generate_unique_string('{{ field_name }}', i),
{%- endif %}
{%- endif %}
{%- endfor %}
                'created_by': user.id,
                'updated_by': user.id,
            }
            {{ model.snake_name }}_data.append(data)
        
        created_{{ resource_ident }} = []
        for data in {{ model.snake_name }}_data:
            {{ model.snake_name }} = {{ model.model_name }}.objects.create(**data)
            created_{{ resource_ident }}.append({{ model.snake_name }})
            # Afficher le premier champ disponible ou l'UUID
{%- set display_field = None %}
{%- for field_name, field in model.fields.items() %}
{%- if field_name not in ['created_by', 'updated_by', 'created_at', 'updated_at', 'uuid'] and field.type in ['CharField', 'TextField'] and display_field is none %}
{%- set display_field = field_name %}
{%- endif %}
{%- endfor %}
{%- if display_field %}
            self.stdout.write('{{ model.model_name }} créé: ' + str({{ model.snake_name }}.{{ display_field }}))
{%- else %}
            self.stdout.write('{{ model.model_name }} créé: ' + str({{ model.snake_name }}.id))
{%- endif %}
        
        self.stdout.write(
            self.style.SUCCESS(
                str(len(created_{{ resource_ident }})) + ' {{ resource_plural }} créé(s) avec succès!'
            )
        )
        
        # Afficher un résumé
        total_count = {{ model.model_name }}.objects.count()
        self.stdout.write(
            self.style.SUCCESS(
                'Total de {{ model.snake_name }}(s) dans la base: ' + str(total_count)
            )
        )
        
        # Afficher les URLs disponibles pour tester
        self.stdout.write('\nURLs disponibles pour tester:')
        self.stdout.write('   GET    /api/v1/{{ resource_plural }}           - Liste tous les {{ resource_plural }}')
        self.stdout.write('   POST   /api/v1/{{ resource_plural }}           - Créer un nouveau {{ model.snake_name }}')
        self.stdout.write('   GET    /api/v1/{{ resource_plural }}/{id}      - Récupérer un {{ model.snake_name }} spécifique')
        self.stdout.write('   PUT    /api/v1/{{ resource_plural }}/{id}      - Mettre à jour un {{ model.snake_name }}')
        self.stdout.write('   DELETE /api/v1/{{ resource_plural }}/{id}      - Supprimer un {{ model.snake_name }}')
        
        self.stdout.write('\nPour tester avec curl:')
        self.stdout.write('   curl -X GET http://localhost:8000/api/v1/{{ resource_plural }}')
        
        self.stdout.write('\nSeeds créés avec succès! Vous pouvez maintenant tester votre API.')
    
    def create_permissions(self):
        """Créer les permissions personnalisées pour le modèle {{ model.model_name }}."""
        
        permissions = [
            ('{{ resource_plural }}.view', 'Can view {{ resource_plural }}'),
            ('{{ resource_plural }}.create', 'Can create {{ resource_plural }}'),
            ('{{ resource_plural }}.update', 'Can update {{ resource_plural }}'),
            ('{{ resource_plural }}.delete', 'Can delete {{ resource_plural }}'),
        ]
        
        for code, description in permissions:
            permission, created = Permission.objects.get_or_create(
                code=code,
                defaults={'description': description}
            )
            if created:
                self.stdout.write(f'Permission créée: {description}')
    
    
    
    def assign_permissions_to_admin_role(self):
        """Assigner toutes les permissions {{ model.model_name }} aux rôles Admin et SuperAdmin."""
        # Récupérer les permissions pour ce modèle
        permissions = Permission.objects.filter(code__startswith='{{ resource_plural }}.')
        
        # Assigner aux rôles Admin et Super Admin
        roles_to_assign = ['Admin', 'Super Admin']
        
        for role_name in roles_to_assign:
            try:
                role = Role.objects.get(name=role_name)
                
                for permission in permissions:
                    if permission not in role.permissions.all():
                        role.permissions.add(permission)
                        self.stdout.write(f'Permission assignée au rôle {role_name}: {permission.code}')
                
                self.stdout.write(f'Toutes les permissions {{ model.model_name }} assignées au rôle {role_name}')
                
            except Role.DoesNotExist:
                self.stdout.write(self.style.ERROR(f'Rôle {role_name} non trouvé'))
                continue