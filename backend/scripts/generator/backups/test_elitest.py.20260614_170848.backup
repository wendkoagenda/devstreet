"""
Tests pour les elitest.
"""
from django.test import TestCase
from rest_framework.test import APITestCase
from rest_framework import status
from app.metier.models import Elitest
from app.metier.services.elitest_service import ElitestService


class ElitestModelTests(TestCase):
    """
    Tests pour le modèle Elitest.
    """

    def setUp(self):
        """Configuration initiale pour les tests."""
        from django.contrib.auth import get_user_model
        User = get_user_model()

        try:
            self.user = User.objects.get(email='admin@example.com')
        except User.DoesNotExist:
            self.user = User.objects.create_superuser(
                username='admin',
                email='admin@example.com',
                password='admin123'
            )

        self.elitest = Elitest.objects.create(
            titre="Test titre",
            description="Test description",
            prix=99.99,
            created_by=self.user.id,
            updated_by=self.user.id
        )

    def test_elitest_creation(self):
        """Test de création d'un elitest."""
        self.assertIsNotNone(self.elitest.id)

    def test_elitest_str_representation(self):
        """Test de la représentation string du elitest."""
        self.assertIsInstance(str(self.elitest), str)


class ElitestServiceTests(TestCase):
    """
    Tests pour le service Elitest.
    """

    def setUp(self):
        """Configuration initiale pour les tests."""
        from django.contrib.auth import get_user_model
        User = get_user_model()

        try:
            self.user = User.objects.get(email='admin@example.com')
        except User.DoesNotExist:
            self.user = User.objects.create_superuser(
                username='admin',
                email='admin@example.com',
                password='admin123'
            )

        self.elitest_service = ElitestService()

    def test_get_all_elitest(self):
        """Test de récupération de tous les elitest."""
        Elitest.objects.create(
            titre="Test titre 1",
            description="Test description 1",
            prix=99.99,
            created_by=self.user.id,
            updated_by=self.user.id
        )
        Elitest.objects.create(
            titre="Test titre 2",
            description="Test description 2",
            prix=199.99,
            created_by=self.user.id,
            updated_by=self.user.id
        )

        elitest = self.elitest_service.get_all()
        self.assertEqual(elitest.count(), 2)

    def test_create_elitest(self):
        """Test de création d'un elitest."""
        data = {
            "titre": "Nouveau titre",
            "description": "Nouveau description",
            "prix": 299.99,
            "created_by": self.user.id,
            "updated_by": self.user.id,
        }

        elitest = self.elitest_service.create(data)
        self.assertEqual(getattr(elitest, 'titre'), "Nouveau titre")


    def test_update_elitest(self):
        """Test de mise à jour d'un elitest."""
        elitest = Elitest.objects.create(
            titre="Original titre",
            description="Original description",
            prix=399.99,
            created_by=self.user.id,
            updated_by=self.user.id
        )

        updated_data = {
            "titre": "Mis à jour titre"
        }
        updated_elitest = self.elitest_service.update(elitest.id, updated_data)
        self.assertEqual(getattr(updated_elitest, 'titre'), "Mis à jour titre")


    def test_delete_elitest(self):
        """Test de suppression d'un elitest."""
        elitest = Elitest.objects.create(
            titre="À supprimer titre",
            description="À supprimer description",
            prix=499.99,
            created_by=self.user.id,
            updated_by=self.user.id
        )

        success = self.elitest_service.delete(elitest.id)
        self.assertTrue(success)
        self.assertFalse(Elitest.objects.filter(id=elitest.id).exists())


class ElitestAPITests(APITestCase):
    """
    Tests pour l'API Elitest.
    """

    def setUp(self):
        """Configuration initiale pour les tests."""
        from django.contrib.auth import get_user_model
        from rest_framework_simplejwt.tokens import RefreshToken
        User = get_user_model()

        try:
            self.user = User.objects.get(email='admin@example.com')
        except User.DoesNotExist:
            self.user = User.objects.create_superuser(
                username='admin',
                email='admin@example.com',
                password='admin123'
            )

        refresh = RefreshToken.for_user(self.user)
        self.access_token = str(refresh.access_token)

        self.elitest = Elitest.objects.create(
            titre="Test API titre",
            description="Test API description",
            prix=599.99,
            created_by=self.user.id,
            updated_by=self.user.id
        )

    def test_elitest_list(self):
        """Test de listage des elitest."""
        self.client.credentials(HTTP_AUTHORIZATION='Bearer ' + self.access_token)
        response = self.client.get(f'/api/v1/elitests')

        self.assertEqual(response.status_code, status.HTTP_200_OK)
        self.assertIsInstance(response.data, list)

    def test_elitest_retrieve(self):
        """Test de récupération d'un elitest."""
        self.client.credentials(HTTP_AUTHORIZATION='Bearer ' + self.access_token)
        response = self.client.get(f'/api/v1/elitests/{self.elitest.id}')

        self.assertEqual(response.status_code, status.HTTP_200_OK)

    def test_elitest_create(self):
        """Test de création d'un elitest."""
        self.client.credentials(HTTP_AUTHORIZATION='Bearer ' + self.access_token)
        data = {
            "titre": "Test titre via API",
            "description": "Description créée via API",
            "prix": "99.99",
        }

        response = self.client.post(f'/api/v1/elitests', data, format='json')
        self.assertEqual(response.status_code, status.HTTP_201_CREATED)

    def test_elitest_partial_update(self):
        """Test de mise à jour partielle d'un elitest."""
        self.client.credentials(HTTP_AUTHORIZATION='Bearer ' + self.access_token)
        data = {
            "titre": "elitest mis à jour"
        }

        response = self.client.patch(f'/api/v1/elitests/{self.elitest.id}', data, format='json')
        self.assertEqual(response.status_code, status.HTTP_200_OK)

    def test_elitest_delete(self):
        """Test de suppression d'un elitest."""
        self.client.credentials(HTTP_AUTHORIZATION='Bearer ' + self.access_token)
        response = self.client.delete(f'/api/v1/elitests/{self.elitest.id}')

        self.assertEqual(response.status_code, status.HTTP_204_NO_CONTENT)
        self.assertFalse(Elitest.objects.filter(id=self.elitest.id).exists())