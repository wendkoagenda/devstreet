# TOUTES les variables ci-dessous sont obligatoires : Django refuse de démarrer si l'une manque
# (aucune valeur de repli dans le code). Les réglages de tuning (taux de limitation, durées des jetons,
# cookies, HSTS, port SMTP) sont des constantes de config/settings.py.
#
# Ce fichier est aussi la liste de référence du déploiement (voir 00readme/PLAN_CD.md) :
# - ligne active (NOM=...)  : variable obligatoire ;
# - ligne commentée (# NOM=...) : variable facultative ;
# - marqueur « # @secret » en fin de ligne : stockée comme secret GitHub (sinon, comme variable).
# Les valeurs ci-dessous sont des exemples de développement : elles ne sont jamais déployées.

# Django
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Secrets : 50 caractères minimum, DIFFÉRENTS l'un de l'autre.
# Générer chaque valeur : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=             # @secret
JWT_SIGNING_KEY=        # @secret

# Compte administrateur (init_data et seeds). Mot de passe : 12 caractères minimum.
ADMIN_EMAIL=
ADMIN_PASSWORD=         # @secret

# Database
DB_NAME=devstreet_bd
DB_USER=postgres
DB_PASSWORD=postgres    # @secret
DB_HOST=localhost
DB_PORT=5432

# CORS et CSRF : origines exactes du frontend (schéma + hôte + port), séparées par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sécurité HTTP
ENABLE_API_DOCS=True          # Swagger/ReDoc : False en production
ENABLE_ADMIN=False            # Admin Django (/admin/) : False par défaut, à activer seulement si nécessaire
USE_X_FORWARDED_PROTO=False   # True derrière un reverse proxy de confiance

# URL publique du frontend (liens dans les e-mails)
FRONTEND_URL=http://localhost:5173

# E-mail (mot de passe oublié)
# Développement : console (les e-mails s'affichent dans le terminal du serveur)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=OnePourcent <no-reply@votre-domaine.com>
# Production : EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend, et ces trois variables deviennent obligatoires
# EMAIL_HOST=smtp.exemple.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=   # @secret

# Stockage : USE_GCS est obligatoire. Si USE_GCS=True, les trois variables GCS suivantes le deviennent aussi.
USE_GCS=False
# GS_BUCKET_NAME=
# GS_PROJECT_ID=
# GCS_UPLOADER_SA=   # @secret (clé de service account GCP, JSON sur une seule ligne)
