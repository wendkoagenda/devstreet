# TOUTES les variables ci-dessous sont obligatoires : Django refuse de démarrer si l'une manque
# (aucune valeur de repli dans le code). Les réglages de tuning (taux de limitation, durées des jetons,
# cookies, HSTS, port SMTP) sont des constantes de config/settings.py.
#
# Ce fichier est aussi la liste de référence du déploiement (voir 00readme/PLAN_CD.md) :
# - ligne active (NOM=...)  : variable obligatoire ;
# - ligne commentée (# NOM=...) : variable facultative ;
# - marqueur « # @secret » en fin de ligne : stockée comme secret GitHub (sinon, comme variable).
# Les valeurs ci-dessous sont des exemples de développement : elles ne sont jamais déployées.

# Django
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Secrets : 50 caractères minimum, DIFFÉRENTS l'un de l'autre.
# Générer chaque valeur : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=             # @secret
JWT_SIGNING_KEY=        # @secret

# Compte administrateur (init_data et seeds). Mot de passe : 12 caractères minimum.
ADMIN_EMAIL=
ADMIN_PASSWORD=         # @secret

# Database
DB_NAME=devstreet_bd
DB_USER=postgres
DB_PASSWORD=postgres    # @secret
DB_HOST=localhost
DB_PORT=5432

# CORS et CSRF : origines exactes du frontend (schéma + hôte + port), séparées par des virgules
# En DEBUG, settings.py ajoute aussi l’IP LAN (:5173) et les tunnels Cloudflare/ngrok.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sécurité HTTP
ENABLE_API_DOCS=True          # Swagger/ReDoc : False en production
ENABLE_ADMIN=False            # Admin Django (/admin/) : False par défaut, à activer seulement si nécessaire
USE_X_FORWARDED_PROTO=False   # True derrière un reverse proxy de confiance

# URL publique du frontend (liens dans les e-mails)
FRONTEND_URL=http://localhost:5173

# OAuth social (facultatif). Sans ces variables, les boutons Google/GitHub restent masqués.
# Redirect URI EXACTE à déclarer chez le provider (= FRONTEND_URL + chemin) :
#   http://localhost:5173/api/auth/oauth/google/callback
#   http://localhost:5173/api/auth/oauth/github/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=   # @secret
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=   # @secret

# E-mail (mot de passe oublié)
# Développement : console (les e-mails s'affichent dans le terminal du serveur)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=OnePourcent <no-reply@votre-domaine.com>
# Production : EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend, et ces trois variables deviennent obligatoires
# EMAIL_HOST=smtp.exemple.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=   # @secret

# Stockage : USE_S3 est obligatoire. False = disque local (MEDIA_ROOT). True = bucket S3/MinIO privé : les fichiers
# ne sont lus que par l'application, via /api/v1/files/ et seulement pour un utilisateur connecté.
# Si USE_S3=True, les quatre variables S3 suivantes deviennent obligatoires.
USE_S3=False
# S3_ENDPOINT_URL=http://minio-serveur:9000
# S3_BUCKET_NAME=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=   # @secret

# DevStreet Hub : intégrations facultatives, une route non configurée répond 503.
# Ne pas mettre les valeurs réelles dans ce fichier suivi par Git.
# DEVSTREET_HUB_GITEA_URL=
# DEVSTREET_HUB_GITEA_PUBLIC_URL=
# DEVSTREET_HUB_GITEA_TOKEN=   # @secret
# DEVSTREET_HUB_GITEA_WEBHOOK_SECRET=   # @secret
# DEVSTREET_HUB_OPENAI_API_KEY=   # @secret (sinon fallback AI_OPENAI_API_KEY)
# DEVSTREET_HUB_OPENAI_MODEL=     # sinon fallback AI_OPENAI_MODEL
# DEVSTREET_HUB_AI_DAILY_LIMIT=20 # sinon fallback AI_DAILY_LIMIT
# DEVSTREET_HUB_AI_PROJECT_DAILY_LIMIT=2  # sinon fallback AI_PROJECT_DAILY_LIMIT (défaut 2)
# DEVSTREET_HUB_AI_INLINE_WORKER=true    # local : traite 1 job après POST /analyses
DEVSTREET_HUB_FORUM_ADAPTER=app.communaute.services.project_topics.create_linked_topic

# Assistant IA partagé (app.ai) : Grok prioritaire, OpenAI en secours.
# Sans clé : les routes /api/v1/ai/* et /assistant/chat répondent 503.
# L'atelier Hub (/analyses) réutilise AI_OPENAI_* si DEVSTREET_HUB_OPENAI_* est vide.
# AI_GROK_API_KEY=          # @secret (clé Groq Cloud gsk_…)
# AI_GROK_BASE_URL=https://api.groq.com/openai/v1
# AI_GROK_MODEL=qwen/qwen3.8-27b
# AI_OPENAI_API_KEY=        # @secret
# AI_OPENAI_MODEL=gpt-4o-mini
# AI_PRIMARY_PROVIDER=grok
# AI_DAILY_LIMIT=50
# AI_PROJECT_DAILY_LIMIT=20
# AI_INLINE_WORKER=true
