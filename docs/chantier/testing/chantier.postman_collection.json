          },
          {
            "key": "X-Gitea-Signature",
            "value": "{{webhook_signature}}"
          },
          {
            "key": "X-Gitea-Delivery",
            "value": "{{delivery_id}}"
          },
          {
            "key": "X-Gitea-Event",
            "value": "push"
          }
        ],
        "url": "{{base_url}}/api/v1/integrations/gitea/webhook",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"repository\": {\"id\": 999999}, \"ref\": \"refs/heads/main\", \"after\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var hookCrypto = require('crypto-js');",
              "const signature = hookCrypto.HmacSHA256(pm.request.body.raw, pm.environment.get('webhook_secret')).toString();",
              "pm.variables.set('webhook_signature', signature);"
            ]
          }
        }
      ]
    },
